---
import Container from '@/components/Container.astro';
---

<section id="preise" class="bg-[#F6F8FA] py-[100px] md:py-[120px]" data-ps="src/components/home/PricingTable.astro:pricing-sec">
  <Container>
    <h2 class="text-[32px] font-bold text-secondary text-center mb-[60px]" data-ps="src/components/home/PricingTable.astro:h2">
      Schlüsseldienst München Preisliste
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-[40px]" data-ps="src/components/home/PricingTable.astro:grid">
      <!-- Türöffnung -->
      <div class="bg-white p-8 rounded-xl shadow-sm border border-border" data-ps="src/components/home/PricingTable.astro:card-1">
        <h3 class="text-[24px] font-bold text-secondary mb-6 border-b pb-4" data-ps="src/components/home/PricingTable.astro:card-1-h3">Türöffnung</h3>
        <p class="text-[14px] text-muted-foreground mb-8" data-ps="src/components/home/PricingTable.astro:card-1-note">
          Die Preise für die Türöffnung variieren je nach Sicherheitsstufe und Verbauung Ihrer Tür.
        </p>
        
        <div class="space-y-4" data-ps="src/components/home/PricingTable.astro:card-1-list">
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTable.astro:item-1">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTable.astro:uswy8a">09:00 – 18:00</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTable.astro:uswy8b">29 – 159€</span>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTable.astro:item-2">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTable.astro:uswy8c">An- und Abfahrtskosten</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTable.astro:uswy8d">23,80€</span>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTable.astro:item-3">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTable.astro:uswy8e">Wochentags 18 – 22:00 Uhr</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTable.astro:uswy8f">+ 50%</span>
          </div>
          <div class="flex justify-between items-center py-3" data-ps="src/components/home/PricingTable.astro:item-4">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTable.astro:a5pz15">Sonn- und Feiertage</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTable.astro:a5pz16">+ 100%</span>
          </div>
        </div>
      </div>

      <!-- Zusatzleistungen -->
      <div class="bg-white p-8 rounded-xl shadow-sm border border-border" data-ps="src/components/home/PricingTable.astro:card-2">
        <h3 class="text-[24px] font-bold text-secondary mb-6 border-b pb-4" data-ps="src/components/home/PricingTable.astro:card-2-h3">Zusatzleistungen</h3>
        <p class="text-[14px] text-muted-foreground mb-8" data-ps="src/components/home/PricingTable.astro:card-2-note">
          Beim Schlüsseldienst München erhalten Sie einiges an Zusatzleistungen.
        </p>
        
        <div class="space-y-4" data-ps="src/components/home/PricingTable.astro:card-2-list">
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTable.astro:item-5">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTable.astro:a5pz17">Angefangene 15 Minuten</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTable.astro:a5pz18">19,90€</span>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTable.astro:item-6">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTable.astro:a5pz19">Sicherheitszylinder</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTable.astro:a5pz1a">ab 49€</span>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTable.astro:item-7">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTable.astro:a5pz1b">Sicherheitsbeschlag</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTable.astro:a5pz1c">ab 79€</span>
          </div>
          <div class="flex justify-between items-center py-3" data-ps="src/components/home/PricingTable.astro:item-8">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTable.astro:a5pz1d">Sonstiges</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTable.astro:a5pz1e">auf Anfrage</span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

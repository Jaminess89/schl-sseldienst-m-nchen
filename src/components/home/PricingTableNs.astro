---
import Container from '@/components/Container.astro';
---

<section id="preise" class="bg-[#F6F8FA] py-[100px] md:py-[120px]" data-ps="src/components/home/PricingTableNs.astro:jv519d">
  <Container>
    <h2 class="text-[32px] font-bold text-secondary text-center mb-[60px]" data-ps="src/components/home/PricingTableNs.astro:z9rf9s">
      Schlüsseldienst München Preisliste
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-[40px]" data-ps="src/components/home/PricingTableNs.astro:r1b0fu">
      <!-- Türöffnung -->
      <div class="bg-white p-8 rounded-xl shadow-sm border border-border" data-ps="src/components/home/PricingTableNs.astro:r1b0fv">
        <h3 class="text-[24px] font-bold text-secondary mb-6 border-b pb-4" data-ps="src/components/home/PricingTableNs.astro:klci26">Türöffnung</h3>
        <p class="text-[14px] text-muted-foreground mb-8" data-ps="src/components/home/PricingTableNs.astro:4o1ary">
          Die Preise für die Türöffnung variieren je nach Sicherheitsstufe und Verbauung Ihrer Tür.
        </p>
        
        <div class="space-y-4" data-ps="src/components/home/PricingTableNs.astro:r1b0fw">
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTableNs.astro:m1h7lg">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTableNs.astro:4qb5ny">09:00 – 18:00</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTableNs.astro:4qb5nx">29 – 159€</span>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTableNs.astro:m1h7lf">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTableNs.astro:4qb5nw">An- und Abfahrtskosten</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTableNs.astro:4qb5nv">23,80€</span>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTableNs.astro:m1h7le">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTableNs.astro:4qb5nu">Wochentags 18 – 22:00 Uhr</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTableNs.astro:4qb5n8">+ 50%</span>
          </div>
          <div class="flex justify-between items-center py-3" data-ps="src/components/home/PricingTableNs.astro:m1h7ld">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTableNs.astro:4qb5n7">Sonn- und Feiertage</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTableNs.astro:4qb5n6">+ 100%</span>
          </div>
        </div>
      </div>

      <!-- Zusatzleistungen -->
      <div class="bg-white p-8 rounded-xl shadow-sm border border-border" data-ps="src/components/home/PricingTableNs.astro:m1h7lc">
        <h3 class="text-[24px] font-bold text-secondary mb-6 border-b pb-4" data-ps="src/components/home/PricingTableNs.astro:klci27">Zusatzleistungen</h3>
        <p class="text-[14px] text-muted-foreground mb-8" data-ps="src/components/home/PricingTableNs.astro:4o1arx">
          Beim Schlüsseldienst München erhalten Sie einiges an Zusatzleistungen.
        </p>
        
        <div class="space-y-4" data-ps="src/components/home/PricingTableNs.astro:m1h7lb">
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTableNs.astro:m1h7la">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTableNs.astro:4qb5n5">Angefangene 15 Minuten</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTableNs.astro:4qb5n4">19,90€</span>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTableNs.astro:m1h7l9">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTableNs.astro:4qb5n3">Sicherheitszylinder</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTableNs.astro:4qb5n2">ab 49€</span>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PricingTableNs.astro:m1h7l8">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTableNs.astro:4qb5n1">Sicherheitsbeschlag</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTableNs.astro:4qb5n0">ab 79€</span>
          </div>
          <div class="flex justify-between items-center py-3" data-ps="src/components/home/PricingTableNs.astro:m1h7l7">
            <span class="font-bold text-secondary" data-ps="src/components/home/PricingTableNs.astro:4qb5mz">Sonstiges</span>
            <span class="bg-primary/10 text-primary px-3 py-1 rounded-lg font-bold" data-ps="src/components/home/PricingTableNs.astro:4qb5md">auf Anfrage</span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

---
import Container from '@/components/Container.astro';
---

<section class="pb-12 pt-8 bg-[#3F789E]" data-ps="src/components/home/SolutionProcess.astro:x9r2b">
  <Container>
    <div class="w-full max-w-5xl mx-auto bg-[#F8F9F8] border-2 border-[#8AC161]/50 rounded-[24px] p-6 md:p-8 xl:p-10 flex flex-col xl:flex-row gap-10 xl:gap-8 items-center shadow-xl md:mt-[-13px]" data-ps="src/components/home/SolutionProcess.astro:wrapper">
      
      <!-- Left Content -->
      <div class="flex flex-col sm:flex-row gap-6 items-start w-full xl:w-[45%]" data-ps="src/components/home/SolutionProcess.astro:left">
        <!-- Green Checkmark Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 md:w-20 md:h-20 shrink-0 text-[#488B22] mt-1" viewBox="0 0 100 100" fill="none" data-ps="src/components/home/SolutionProcess.astro:check-icon">
          <rect x="20" y="25" width="55" height="55" rx="4" stroke="currentColor" stroke-width="7" fill="none" />
          <path d="M 35 55 L 48 68 L 92 18" stroke="currentColor" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
        
        <div class="flex flex-col gap-4" data-ps="src/components/home/SolutionProcess.astro:text-content">
          <h2 class="text-[26px] md:text-[30px] font-black leading-[1.1] text-secondary" data-ps="src/components/home/SolutionProcess.astro:qzab3d">
            Die Lösung:<br />Belegen statt hoffen
          </h2>
          <div class="text-[15px] leading-relaxed text-foreground flex flex-col gap-3" data-ps="src/components/home/SolutionProcess.astro:jdndm8">
            <p data-ps="src/components/home/SolutionProcess.astro:ielhw7">Wir montieren, prüfen und warten nach DIN 14676 und dokumentieren jeden Schritt digital.</p>
            <p class="font-bold" data-ps="src/components/home/SolutionProcess.astro:ielhw6">Im Ernstfall können Sie zeigen, was wann geprüft wurde.</p>
          </div>
        </div>
      </div>

      <!-- Right Steps -->
      <div class="flex flex-col md:flex-row items-start justify-between w-full xl:w-[55%] gap-6 xl:pl-4 md:gap-4" data-ps="src/components/home/SolutionProcess.astro:right">
        
        <!-- Step 1 -->
        <div class="flex flex-col items-center text-center w-full md:w-1/3" data-ps="src/components/home/SolutionProcess.astro:step1">
          <!-- Smoke Detector Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 md:w-16 md:h-16 text-[#0A265E] mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Top surface of the outer shell -->
            <ellipse cx="12" cy="8" rx="8" ry="3" />
            <!-- Outer shell body -->
            <path d="M4 8v4c0 1.7 3.6 3 8 3s8-1.3 8-3V8" />
            <!-- Inner sensor part dropping down -->
            <path d="M7 12v4c0 1.1 2.2 2 5 2s5-.9 5-2v-4" />
            <!-- A small detail/hole on the top surface -->
            <ellipse cx="15.5" cy="7.5" rx="0.8" ry="0.4" stroke="currentColor" fill="none"/>
            <!-- Detail inside the sensor part -->
            <path d="M9 16c1 .5 5 .5 6 0" />
          </svg>
          <h3 class="text-[17px] font-bold text-secondary mb-1" data-ps="src/components/home/SolutionProcess.astro:rgby8c">Montage</h3>
          <p class="text-[13px] leading-snug text-foreground" data-ps="src/components/home/SolutionProcess.astro:ielhw5">Fachgerecht<br />nach DIN 14676</p>
        </div>

        <!-- Arrow -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#488B22] shrink-0 hidden md:block mt-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" data-ps="src/components/home/SolutionProcess.astro:arrow1">
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>

        <!-- Step 2 -->
        <div class="flex flex-col items-center text-center w-full md:w-1/3" data-ps="src/components/home/SolutionProcess.astro:step2">
          <!-- Clipboard Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 md:w-16 md:h-16 text-[#0A265E] mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
            <path d="M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z"/>
            <path d="M8 10.5l1.5 1.5L12 9.5"/>
            <path d="M14 10.5h3"/>
            <path d="M8 14.5l1.5 1.5L12 13.5"/>
            <path d="M14 14.5h3"/>
            <path d="M8 18.5l1.5 1.5L12 17.5"/>
            <path d="M14 18.5h3"/>
          </svg>
          <h3 class="text-[17px] font-bold text-secondary mb-1" data-ps="src/components/home/SolutionProcess.astro:rgby8b">Dokumentation</h3>
          <p class="text-[13px] leading-snug text-foreground" data-ps="src/components/home/SolutionProcess.astro:ielhw4">Digital<br />jederzeit abrufbar</p>
        </div>

        <!-- Arrow -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#488B22] shrink-0 hidden md:block mt-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" data-ps="src/components/home/SolutionProcess.astro:arrow2">
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>

        <!-- Step 3 -->
        <div class="flex flex-col items-center text-center w-full md:w-1/3" data-ps="src/components/home/SolutionProcess.astro:step3">
          <!-- Shield Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 md:w-16 md:h-16 text-[#0A265E] mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m8.5 12 2.5 2.5 4.5-4.5"/>
          </svg>
          <h3 class="text-[17px] font-bold text-secondary mb-1" data-ps="src/components/home/SolutionProcess.astro:rgby8a">Rechtssicherheit</h3>
          <p class="text-[13px] leading-snug text-foreground" data-ps="src/components/home/SolutionProcess.astro:ielhw3">Nachweisbar<br />im Ernstfall</p>
        </div>

      </div>
    </div>
  </Container>
</section>
---
import Container from '@/components/Container.astro';
---

<section class="py-[92px] bg-white" data-ps="src/components/home/LeadIntroWq.astro:4flett">
  <Container class="flex flex-col md:flex-row items-center gap-12">
    <div class="w-full md:w-1/2 flex justify-center" data-ps="src/components/home/LeadIntroWq.astro:fkpr7e">
      <div class="relative w-[280px] h-[280px] rounded-full overflow-hidden border-[10px] border-[#ECF0F1]" data-ps="src/components/home/LeadIntroWq.astro:fkpr7f">
        <img 
          src="https://pagesmith-cdn.com/2be62e80/images/Monteur-rund-640.webp" 
          alt="Monteur Schlüsseldienst München" 
          class="w-full h-full object-cover" data-ps="src/components/home/LeadIntroWq.astro:eaj7fw" />
      </div>
    </div>

    <div class="w-full md:w-1/2 text-center md:text-left" data-ps="src/components/home/LeadIntroWq.astro:fkpr7g">
      <h2 class="text-[32px] md:text-[44px] font-bold text-secondary mb-6" data-ps="src/components/home/LeadIntroWq.astro:afe1k1">
        Fairer Schlüsseldienst München gesucht?
      </h2>
      <p class="text-[18px] text-foreground mb-6" data-ps="src/components/home/LeadIntroWq.astro:ecsnlj">
        24 Stunden Notdienst in allen Stadtteilen
      </p>
      <p class="text-[16px] leading-relaxed mb-8" data-ps="src/components/home/LeadIntroWq.astro:ecsnlk">
        Wir sind in allen <strong>Stadtteilen Münchens</strong> tätig und helfen unseren Kunden seit Jahren schnell und zuverlässig wieder in ihre vier Wände. Rufen Sie einfach an und einer unserer Schlüsseldienste in München kommt <strong>innerhalb von 10 – 40 Minuten</strong> zu Ihnen.
      </p>
      
      <a 
        href="tel:+4915735981964" 
        class="inline-flex items-center gap-3 bg-primary hover:bg-primary-hover text-white text-[18px] font-bold px-[24px] py-[12px] rounded-[9px] no-underline transition-all"
       data-ps="src/components/home/LeadIntroWq.astro:pxxwid">
        <span data-ps="src/components/home/LeadIntroWq.astro:sxge3f">0157 359 819 64</span>
        <span data-ps="src/components/home/LeadIntroWq.astro:sxge3g">Jetzt anrufen!</span>
      </a>
    </div>
  </Container>
</section>

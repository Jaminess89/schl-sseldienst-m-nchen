---
import Container from '@/components/Container.astro';
---

<section class="bg-white py-4 border-y border-black/5" data-ps="src/components/home/TrustBanner.astro:trust-sec">
  <Container class="flex flex-wrap items-center justify-between gap-6">
    <div class="flex items-center gap-4" data-ps="src/components/home/TrustBanner.astro:seal-col">
      <div class="flex items-center gap-3 md:justify-center justify-center md:mt-0 md:pt-0 md:pb-0 md:mb-0.5 md:pr-0 md:mr-0 rounded-none md:pl-0 md:ml-[60px]" data-ps="src/components/home/TrustBanner.astro:rating-container">
        <img src="https://pagesmith-cdn.com/2be62e80/images/ChatGPT-Image-Jul-9,-2026,-05_05_24-PM-768.webp" alt="Google Logo" class="w-10 h-auto md:w-[66px]" data-ps="src/components/home/TrustBanner.astro:google-logo" />
        <div class="text-black flex flex-col items-start" data-ps="src/components/home/TrustBanner.astro:rating-box">
          <span class="text-[14px] font-black uppercase tracking-wider leading-none md:text-[13px]" data-ps="src/components/home/TrustBanner.astro:label-top">AUSGEZEICHNET</span>
          <div class="flex gap-0.5 text-[#FFB400] py-1 md:pt-1" data-ps="src/components/home/TrustBanner.astro:stars-row">
            {[1, 2, 3, 4, 5].map(() => (
              <svg class="w-4 h-4 md:w-5 md:h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z" />
              </svg>
            ))}
          </div>
          <span class="text-[12px] font-medium opacity-70 leading-none md:text-xs" data-ps="src/components/home/TrustBanner.astro:label-bottom">5,0 aus 22 Bewertungen</span>
        </div>
      </div>
    </div>

    <ul class="flex flex-col md:flex-row gap-4 md:gap-12 list-none p-0 m-0 text-black text-[14px] md:text-[16px] font-bold md:ml-auto" data-ps="src/components/home/TrustBanner.astro:list">
      <li class="flex items-center gap-3 tracking-tight" data-ps="src/components/home/TrustBanner.astro:item-1">
        <div class="bg-[#1AAAE6] rounded-full p-1" data-ps="src/components/home/TrustBanner.astro:icon-1">
          <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        Feste Preise
      </li>
      <li class="flex items-center gap-3 tracking-tight" data-ps="src/components/home/TrustBanner.astro:item-2">
        <div class="bg-[#1AAAE6] rounded-full p-1" data-ps="src/components/home/TrustBanner.astro:icon-2">
          <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        Saubere Installation
      </li>
      <li class="flex items-center gap-3 tracking-tight" data-ps="src/components/home/TrustBanner.astro:item-3">
        <div class="bg-[#1AAAE6] rounded-full p-1" data-ps="src/components/home/TrustBanner.astro:icon-3">
          <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        Zertifizierte Fachkräfte
      </li>
      <li class="flex items-center gap-3 tracking-tight" data-ps="src/components/home/TrustBanner.astro:item-4">
        <div class="bg-[#1AAAE6] rounded-full p-1" data-ps="src/components/home/TrustBanner.astro:icon-4">
          <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        Schnelle Reaktion
      </li>
    </ul>
  </Container>
</section>

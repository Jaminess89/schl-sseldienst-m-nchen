---
import Container from '@/components/Container.astro';
---

<section class="relative z-40 pb-12 bg-gradient-to-b from-black to-[#3F789E] md:pb-[18px]" data-ps="src/components/home/FineWarning.astro:fw-sec">
  <Container>
    <div class="relative z-50 max-w-5xl mx-auto bg-white rounded-2xl shadow-xl border border-black/5 p-6 md:p-10 -mt-20 md:-mt-24 md:mt-[-164px]" data-ps="src/components/home/FineWarning.astro:fw-card">
      <div class="flex flex-col md:flex-row gap-6 md:gap-10 items-center md:items-start" data-ps="src/components/home/FineWarning.astro:fw-content">
        <!-- Warning Icon -->
        <div class="flex-shrink-0" data-ps="src/components/home/FineWarning.astro:fw-icon-wrap">
          <div class="w-24 h-24 md:w-32 md:h-32 bg-[#fff1f0] rounded-full flex items-center justify-center" data-ps="src/components/home/FineWarning.astro:fw-icon-bg">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#E24A3B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-14 h-14 md:w-20 md:h-20" data-ps="src/components/home/FineWarning.astro:fw-svg-warn">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
              <path d="M12 9v4"></path>
              <path d="M12 17h.01"></path>
            </svg>
          </div>
        </div>

        <!-- Text Content -->
        <div class="flex-grow space-y-4 text-center md:text-left" data-ps="src/components/home/FineWarning.astro:fw-text-col">
          <h2 class="text-3xl md:text-[34px] font-black text-secondary leading-tight" data-ps="src/components/home/FineWarning.astro:fw-title">
            Bis zu <span class="text-[#E24A3B]" data-ps="src/components/home/FineWarning.astro:wvurf0">500.000 €</span> Bußgeld
          </h2>
          
          <p class="text-foreground text-lg md:text-xl leading-relaxed font-medium" data-ps="src/components/home/FineWarning.astro:fw-desc">
            Bei bestimmten vorsätzlichen Verstößen sind nach § 85 BauO Bln/BbgBO bis zu 500.000 € möglich. Bei Fahrlässigkeit grundsätzlich bis zu 250.000 €.
          </p>

          <!-- Info Box -->
          <div class="bg-[#fdf3f2] border border-red-100/50 rounded-2xl p-4 md:p-5 flex gap-4 items-start text-left" data-ps="src/components/home/FineWarning.astro:fw-info">
            <div class="bg-white rounded-full p-1 shadow-sm" data-ps="src/components/home/FineWarning.astro:u3k2n">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1E4D8C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 shrink-0 text-[#1E4D8C]" data-ps="src/components/home/FineWarning.astro:fw-svg-info">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 16v-4"></path>
                <path d="M12 8h.01"></path>
              </svg>
            </div>
            <p class="text-base md:text-[17px] text-secondary font-semibold leading-relaxed" data-ps="src/components/home/FineWarning.astro:fw-info-text">
              Ein fehlender Melder kostet nicht automatisch 500.000 €. Der Höchstbetrag kann etwa relevant werden, wenn eine Anordnung der Bauaufsicht ignoriert wird.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

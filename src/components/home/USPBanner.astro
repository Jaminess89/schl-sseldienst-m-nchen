---
import Container from '@/components/Container.astro';

const usps = [
  {
    title: "24 Stunden",
    subtitle: "Schlüsselnotdienst",
    img: "https://pagesmith-cdn.com/2be62e80/images/telefon-63.webp"
  },
  {
    title: "90% schadenfreie",
    subtitle: "Türöffnungen",
    img: "https://pagesmith-cdn.com/2be62e80/images/kundenzufriedenheit-63.webp"
  },
  {
    title: "Bar- und EC- Zahlung",
    subtitle: "möglich",
    img: "https://pagesmith-cdn.com/2be62e80/images/guenstige-tueroeffnung-63.webp"
  },
  {
    title: "In 10 – 40 Minuten",
    subtitle: "vor Ort",
    img: "https://pagesmith-cdn.com/2be62e80/images/wir-sind-experten-63.webp"
  }
];
---

<section class="relative py-[80px] md:py-[100px] overflow-hidden" data-ps="src/components/home/USPBanner.astro:usp-sec">
  <!-- Background with Overlay -->
  <div class="absolute inset-0 z-0" data-ps="src/components/home/USPBanner.astro:bg">
    <img 
      src="https://www.xn--schlsseldienst-mnchen-cicm.bayern/wp-content/uploads/2021/04/freundlicher-handwerker-e1619617748689.jpg" 
      alt="Handwerker" 
      class="w-full h-full object-cover" data-ps="src/components/home/USPBanner.astro:4yw7xd" />
    <div class="absolute inset-0 bg-[#7ACD37]/90 mix-blend-multiply" data-ps="src/components/home/USPBanner.astro:yu56kn"></div>
    <div class="absolute inset-0 bg-[#0D334A]/40" data-ps="src/components/home/USPBanner.astro:yu56ko"></div>
  </div>

  <Container class="relative z-10">
    <h2 class="text-[32px] font-bold text-white text-center mb-16" data-ps="src/components/home/USPBanner.astro:h2">Warum Schlüsseldienst München?</h2>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8" data-ps="src/components/home/USPBanner.astro:grid">
      {usps.map((usp, i) => (
        <div class="flex flex-col items-center text-center" data-ps={`src/components/home/USPBanner.astro:item-${i}`}>
          <div class="w-[63px] h-[63px] mb-6" data-ps="src/components/home/USPBanner.astro:icon">
            <img src={usp.img} alt={usp.title} class="w-full h-full object-contain" data-ps={`src/components/home/USPBanner.astro:4yw7xe-${i}`} />
          </div>
          <p class="text-[18px] md:text-[20px] font-bold text-white leading-tight" data-ps="src/components/home/USPBanner.astro:title">
            {usp.title}
          </p>
          <p class="text-[16px] text-white opacity-90" data-ps="src/components/home/USPBanner.astro:sub">
            {usp.subtitle}
          </p>
        </div>
      ))}
    </div>
  </Container>
</section>

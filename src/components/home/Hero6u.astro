---
import Container from '@/components/Container.astro';
---

<section class="relative bg-[#ECF0F1] overflow-hidden" data-ps="src/components/home/Hero6u.astro:w9lnb7">
  <Container class="relative z-10 pt-[55px] pb-12 md:pb-[75px]">
    <div class="w-full md:w-1/2 text-center md:text-left md:pr-12 md:pl-16 md:mr-0" data-ps="src/components/home/Hero6u.astro:l2t4rq">
      <h1 class="text-[40px] font-black text-secondary leading-[1.1] mb-4 md:text-[28px]" data-ps="src/components/home/Hero6u.astro:f727h1">Rauchmelder Service Berlin & Umland</h1>
      <div class="flex flex-col gap-3 mb-8 w-fit mx-auto md:mx-0 md:items-stretch" data-ps="src/components/home/Hero6u.astro:l2t4rr">
        <p class="flex items-center gap-3 text-[18px] font-bold text-secondary md:text-lg md:items-center md:text-left text-left" data-ps="src/components/home/Hero6u.astro:mkv2ai">
          <svg class="w-6 h-6 text-[#1AAAE6] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
Installation & Wartung nach DIN 14676
</p>
        <p class="flex items-center gap-3 text-[18px] font-bold text-secondary md:text-lg md:text-left text-left" data-ps="src/components/home/Hero6u.astro:eh59r2">
          <svg class="w-6 h-6 text-[#1AAAE6] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
Vollständige Haftungsabsicherung
</p>
        <p class="flex items-center gap-3 text-[18px] font-bold text-secondary md:text-lg" data-ps="src/components/home/Hero6u.astro:eh59r1">
          <svg class="w-6 h-6 text-[#1AAAE6] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
          Gerichtsfeste Dokumentation
        </p>
        <p class="flex items-center gap-3 text-[18px] font-bold text-secondary md:text-lg" data-ps="src/components/home/Hero6u.astro:eh59r0">
          <svg class="w-6 h-6 text-[#1AAAE6] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
Kosten auf Mieter übertragbar
</p>
      </div>
      
      <a 
        href="tel:+4915735981964" 
        class="inline-flex items-center gap-3 bg-[#81CD35] hover:bg-[#81CD35]/90 text-white text-[18px] font-bold px-[16px] py-[12px] rounded-[9px] no-underline transition-all shadow-lg"
       data-ps="src/components/home/Hero6u.astro:fgx5kq">
        <span class="text-[20px] md:block" data-ps="src/components/home/Hero6u.astro:x87qrj">Kostenlos Berechnen Lassen</span>
      </a>
    </div>
  </Container>

  <div class="w-full md:w-1/2 md:absolute md:inset-y-0 md:right-0" data-ps="src/components/home/Hero6u.astro:l2t4rs">
    <div class="relative h-full w-full [mask-image:linear-gradient(to_bottom,transparent,#3F789E_15%)] md:[mask-image:linear-gradient(to_right,transparent,#3F789E_20%)]" data-ps="src/components/home/Hero6u.astro:l2t4rt">
      <img 
        src="https://pagesmith-cdn.com/2be62e80/images/Rachmelder-Service-Techniker-1024.webp" 
        alt="Rauchmelderservice Berlin" 
        class="w-full h-full object-cover min-h-[300px] md:min-h-0"
        loading="eager"
        fetchpriority="high" data-ps="src/components/home/Hero6u.astro:8sftvk" />
    </div>
  </div>
</section>

---
import Container from '@/components/Container.astro';

const slides = [
  {
    title: "Türschloss wechseln",
    text: "Ein verlorener Haustürschlüssel ist ein Sicherheitsrisiko. Lassen Sie daher schnellstmöglich das Türschloss austauschen. Der Schlüsselnotdienst München wird schnell und zum fairen Preis Ihr Haustürschloss austauschen.",
    img: "https://pagesmith-cdn.com/2be62e80/images/schlosstausch-durch-schluesseldienst-e1619558370958-768.webp"
  },
  {
    title: "Schloss austauschen",
    text: "Es kann aus unterschiedlichen Gründen sinnvoll sein, ein älteres Schloss austauschen zu lassen. Einerseits kann natürlicher Verschleiß die Funktion einschränken, auf der anderen Seite bieten moderne Schlösser interessante Sicherheitsfeatures.",
    img: "https://pagesmith-cdn.com/2be62e80/images/schloss-tauschen-e1619558564919-768.webp"
  },
  {
    title: "Schließzylinder wechseln",
    text: "Verschleiß ist ein häufiger Grund für klemmende oder defekte Türschlösser. Lassen Sie bereits bei den ersten Anzeichen für ein klemmendes Türschloss frühzeitig den Schließzylinder austauschen.",
    img: "https://pagesmith-cdn.com/2be62e80/images/austausch-von-schloss-e1619558456735-768.webp"
  },
  {
    title: "Briefkastenschloss wechseln",
    text: "Im Briefkasten wartet ein wichtiger Brief auf Sie und Sie haben den Briefkastenschlüssel verloren? Keine Sorge! Der Schlüsseldienst München hilft Ihnen gerne weiter.",
    img: "https://pagesmith-cdn.com/2be62e80/images/briefkasten-e1619558319460-768.webp"
  },
  {
    title: "Tür reparieren",
    text: "Ihr Türschloss ist defekt? Sparen Sie bares Geld und lassen Sie Ihr Türschloss reparieren. Es ist nicht in jedem Fall erforderlich, das komplette Schloss auszuwechseln.",
    img: "https://pagesmith-cdn.com/2be62e80/images/handwerker-schlosstauschjpg-e1619558502843-768.webp"
  }
];
---

<section class="bg-[#0D334A] py-[100px] text-white" data-ps="src/components/home/ServicesSlider.astro:slider-sec">
  <Container>
    <h2 class="text-[32px] font-bold text-center mb-16" data-ps="src/components/home/ServicesSlider.astro:h2">
      Schlosstausch und Zylindertausch durch den Schlüsseldienst München
    </h2>

    <div class="relative" data-ps="src/components/home/ServicesSlider.astro:slider-container">
      <div id="services-slider" class="flex overflow-x-auto snap-x snap-mandatory scrollbar-hide gap-8 pb-8" data-ps="src/components/home/ServicesSlider.astro:track">
        {slides.map((slide, i) => (
          <div class="min-w-full md:min-w-[calc(100%-40px)] snap-center flex flex-col md:flex-row items-center gap-12" data-ps={`src/components/home/ServicesSlider.astro:slide-${i}`}>
            <div class="w-full md:w-1/2 relative" data-ps="src/components/home/ServicesSlider.astro:img-col">
              <div class="absolute -inset-4 border-[14px] border-[#1AAAE6] z-0" data-ps="src/components/home/ServicesSlider.astro:frame"></div>
              <div class="relative z-10 aspect-square overflow-hidden" data-ps="src/components/home/ServicesSlider.astro:img-box">
                <img src={slide.img} alt={slide.title} class="w-full h-full object-cover" data-ps={`src/components/home/ServicesSlider.astro:o691nj-${i}`} />
              </div>
            </div>
            
            <div class="w-full md:w-1/2" data-ps="src/components/home/ServicesSlider.astro:text-col">
              <h3 class="text-[32px] font-bold mb-6" data-ps="src/components/home/ServicesSlider.astro:h3">{slide.title}</h3>
              <p class="text-[18px] text-white/75 leading-relaxed" data-ps="src/components/home/ServicesSlider.astro:p">{slide.text}</p>
            </div>
          </div>
        ))}
      </div>
      
      <!-- Custom Pager -->
      <div class="flex justify-center gap-4 mt-8" data-ps="src/components/home/ServicesSlider.astro:pager">
        {slides.map((_, i) => (
          <button 
            class="w-3 h-3 rounded-full bg-white/20 hover:bg-[#1AAAE6] transition-colors"
            aria-label={`Go to slide ${i + 1}`}
            onclick={`document.getElementById('services-slider').scrollTo({left: ${i} * document.getElementById('services-slider').offsetWidth, behavior: 'smooth'})`}
           data-ps={`src/components/home/ServicesSlider.astro:h3hnh2-${i}`}></button>
        ))}
      </div>
    </div>
  </Container>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

---
import Container from '@/components/Container.astro';

const faqs = [
  {
    q: "Warum der Schlüsseldienst München?",
    a: "Der Schlüsseldienst München sticht mit seinen kundenfreundlichen Festpreisen und der qualitativen Arbeit aus der Masse heraus. Hier erhalten Sie zu allen Tages- und Nachtzeiten innerhalb von 10 – 40 Minuten kompetente und schnelle Hilfe."
  },
  {
    q: "Wie lange braucht der Schlüsseldienst München zu mir?",
    a: "Innerhalb von München sind die Monteure vom Schlüsseldienst München bereits binnen 10 – 40 Minuten bei Ihnen. Dies gilt für Wochentage ebenso, wie für Wochenenden und Feiertage."
  },
  {
    q: "Was kostet die Türöffnung beim Schlüsseldienst München?",
    a: "Bereits ab kundenfreundlichen 29 € können Sie die Dienste vom Schlüsseldienst München im gesamten Stadtgebiet beanspruchen."
  },
  {
    q: "Verursacht der Einsatz Schäden an meiner Tür?",
    a: "Durch die jahrelange Erfahrung und modernste Werkzeuge kann eine schadenfreie Öffnung von Türen, Autos und Tresoren in 90% der Fälle garantiert werden."
  },
  {
    q: "Wie kann ich die Leistungen vom Schlüsseldienst München bezahlen?",
    a: "Jeder Monteur vom Schlüsseldienst München ist mit einem Kartenlesegerät ausgestattet, sodass Sie niemals gezwungen sind, vorher zum Geldautomaten zu gehen. Falls Sie Barzahlung bevorzugen, ist dies natürlich auch möglich."
  }
];
---

<section class="bg-[#F6F8FA] py-[112px]" data-ps="src/components/home/FAQAccordion.astro:faq-sec">
  <Container class="max-w-[740px]">
    <h2 class="text-[32px] font-bold text-secondary text-center mb-12" data-ps="src/components/home/FAQAccordion.astro:h2">Häufig gestellte Fragen</h2>
    
    <div class="space-y-4" data-ps="src/components/home/FAQAccordion.astro:list">
      {faqs.map((faq, i) => (
        <details class="group bg-white rounded-lg border border-border overflow-hidden" data-ps={`src/components/home/FAQAccordion.astro:item-${i}`}>
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-bold text-secondary text-[20px]">
            {faq.q}
            <span class="transition-transform group-open:rotate-180" data-ps={`src/components/home/FAQAccordion.astro:vpuya0-${i}`}>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-[18px] text-[#475B61] leading-relaxed" data-ps={`src/components/home/FAQAccordion.astro:ans-${i}`}>
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </Container>
</section>

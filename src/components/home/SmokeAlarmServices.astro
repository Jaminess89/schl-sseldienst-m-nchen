---
import Container from '@/components/Container.astro';

const services = [
  {
    title: "Planung und Montage",
    description: `✓ Räume prüfen
✓ Melder auswählen
✓ Montagepunkte festlegen
✓ Fachgerecht montieren`,
    image: "https://images.pexels.com/photos/8005397/pexels-photo-8005397.jpeg?auto=compress&cs=tinysrgb&w=800"
  },
  {
    title: "Wartung und Prüfung",
    description: `✓ Montageposition prüfen
✓ Funktionstest durchführen
✓ Batteriestatus kontrollieren
✓ Zustand bewerten`,
    image: "https://images.pexels.com/photos/8292837/pexels-photo-8292837.jpeg?auto=compress&cs=tinysrgb&w=800"
  },
  {
    title: "Austausch und Nachrüstung",
    description: `✓ Bedarf ermitteln
✓ Geeignete Melder auswählen
✓ Defekte Geräte austauschen
✓ Positionierung optimieren`,
    image: "https://images.pexels.com/photos/4792521/pexels-photo-4792521.jpeg?auto=compress&cs=tinysrgb&w=800"
  }
];
---

<section class="py-16 md:py-24 md:pt-[33px] md:pb-[45px]" style="background-color: #3F789E;" data-ps="src/components/home/SmokeAlarmServices.astro:8glkdm">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-ps="src/components/home/SmokeAlarmServices.astro:truz0h">
        <div 
          class="flex flex-col group h-full"
          data-aos="fade-up"
          data-aos-delay="0"
         data-ps="src/components/home/SmokeAlarmServices.astro:truz0g-0">
          <div class="relative overflow-hidden rounded-2xl aspect-[4/3] mb-8 shadow-xl" data-ps="src/components/home/SmokeAlarmServices.astro:truz0f-0">
            <img 
              src="https://pagesmith-cdn.com/2be62e80/images/ChatGPT-Image-Jul-10,-2026,-02_25_11-PM-1536.webp" 
              alt="Wartung und Prüfung"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy" data-ps="src/components/home/SmokeAlarmServices.astro:be04bd-0" />
          </div>
          
          <div class="flex flex-col flex-grow" data-ps="src/components/home/SmokeAlarmServices.astro:truz0e-0">
            <h3 class="text-white/90 leading-relaxed font-bold mb-2 md:mt-[-12px] md:text-[22px] text-[22px]" data-ps="src/components/home/SmokeAlarmServices.astro:1m7sas-0">Wartung & Prüfung</h3>
            <div class="flex flex-col gap-1.5 text-white/90 leading-relaxed font-medium" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-0-wrapper">
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-0-1">✓ Funktion testen</p>
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-0-2">✓ Batterie prüfen</p>
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-0-3">✓ Mängel erkennen</p>
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-0-4">✓ Geräte austauschen</p>
            </div>
          </div>
        </div>

        <div 
          class="flex flex-col group h-full"
          data-aos="fade-up"
          data-aos-delay="100"
         data-ps="src/components/home/SmokeAlarmServices.astro:truz0g-1">
          <div class="relative overflow-hidden rounded-2xl aspect-[4/3] mb-8 shadow-xl" data-ps="src/components/home/SmokeAlarmServices.astro:truz0f-1">
            <img 
              src="https://pagesmith-cdn.com/2be62e80/images/ChatGPT-Image-Jul-10,-2026,-12_29_03-PM-1024.webp" 
              alt="Planung und Montage"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy" data-ps="src/components/home/SmokeAlarmServices.astro:be04bd-1" />
          </div>
          
          <div class="flex flex-col flex-grow" data-ps="src/components/home/SmokeAlarmServices.astro:truz0e-1">
            <h3 class="text-white/90 leading-relaxed font-bold mb-2 md:mt-[-12px] md:text-[22px] text-[22px]" data-ps="src/components/home/SmokeAlarmServices.astro:1m7sas-1">Planung & Montage</h3>
            <div class="flex flex-col gap-1.5 text-white/90 leading-relaxed font-medium" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-1-wrapper">
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-1-1">✓ Bedarf ermitteln</p>
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-1-2">✓ Melder auswählen</p>
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-1-3">✓ Position festlegen</p>
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-1-4">✓ Fachgerecht montieren</p>
            </div>
          </div>
        </div>

        <div 
          class="flex flex-col group h-full"
          data-aos="fade-up"
          data-aos-delay="200"
         data-ps="src/components/home/SmokeAlarmServices.astro:truz0g-2">
          <div class="relative overflow-hidden rounded-2xl aspect-[4/3] mb-8 shadow-xl" data-ps="src/components/home/SmokeAlarmServices.astro:truz0f-2">
            <img 
              src="https://pagesmith-cdn.com/2be62e80/images/Protokoll-&-Dokumentation-1024.webp" 
              alt="Austausch und Nachrüstung"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy" data-ps="src/components/home/SmokeAlarmServices.astro:be04bd-2" />
          </div>
          
          <div class="flex flex-col flex-grow" data-ps="src/components/home/SmokeAlarmServices.astro:truz0e-2">
            <h3 class="text-white/90 leading-relaxed font-bold mb-2 md:mt-[-12px] md:text-[22px] text-[22px]" data-ps="src/components/home/SmokeAlarmServices.astro:1m7sas-2">Dokumentation & Sicherheit</h3>
            <div class="flex flex-col gap-1.5 text-white/90 leading-relaxed font-medium" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-2-wrapper">
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-2-1">✓ Prüfung dokumentieren</p>
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-2-2">✓ Protokoll erstellen</p>
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-2-3">✓ Nachweise sichern</p>
              <p class="md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-2-4">✓ Risiken reduzieren</p>
            </div>
          </div>
        </div>
    </div>
  </Container>
</section>

<style>
  /* Optional: Add a subtle glow to cards on hover */
  .group:hover img {
    filter: brightness(1.1);
  }
</style>

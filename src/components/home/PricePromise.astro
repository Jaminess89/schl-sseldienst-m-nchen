---
import Container from '@/components/Container.astro';
---

<section class="bg-gradient-to-r from-[#1AAAE6] to-[#4FCFC5] py-[52px] md:mb-0 md:pt-[23px] md:pb-[23px]" data-ps="src/components/home/PricePromise.astro:promise-sec">
  <Container class="text-center text-white">
    <h3 class="text-[24px] font-bold mb-4 md:text-[23px]" data-ps="src/components/home/PricePromise.astro:h3">Achtung: Seit 2021 Pflicht in Berlin.</h3>
    <p class="text-[18px] max-w-3xl mx-auto" data-ps="src/components/home/PricePromise.astro:p">Vermeiden Sie jetzt teure Bußgelder und Haftungsklagen.</p>
  </Container>
</section>

---
// NEW SECTION F — Benefits for property managers
const benefits = [
  { title: 'Zentraler Ansprechpartner', text: 'Sie erhalten einen festen Kontakt für Rückfragen, Terminabsprachen und die weitere Planung.', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { title: 'Strukturierter Ablauf', text: 'Von der ersten Anfrage bis zur abschließenden Übersicht sind die nächsten Schritte klar nachvollziehbar.', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4' },
  { title: 'Weniger Koordinationsaufwand', text: 'Auf Wunsch unterstützen wir bei der Abstimmung mit Bewohnern und der Nachverfolgung offener Wohnungen.', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { title: 'Nachvollziehbare Ergebnisse', text: 'Geprüfte Geräte, festgestellte Auffälligkeiten und ausgeführte Maßnahmen werden übersichtlich zusammengeführt.', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { title: 'Transparente Kalkulation', text: 'Sie erhalten eine verständliche Aufstellung der vereinbarten Leistungen und Kosten.', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { title: 'Skalierbar für mehrere Objekte', text: 'Auch mehrere Wohnungen, Gebäude oder Liegenschaften können strukturiert angefragt und geplant werden.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
];
---

<section id="vorteile" class="py-16 md:py-24 bg-[#F6F9FC]">
  <div class="max-w-[1200px] mx-auto px-4">
    <div class="text-center max-w-[720px] mx-auto mb-12 reveal">
      <span class="inline-block text-[13px] font-bold uppercase tracking-wider text-[#4B9511] bg-[#8CC63F]/10 px-3 py-1 rounded-full mb-4">Für Immobilienverantwortliche entwickelt</span>
      <h2 class="text-3xl md:text-[38px] font-bold text-secondary tracking-tight">Mehr Überblick über Geräte, Maßnahmen und offene Punkte</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {benefits.map((b, i) => (
        <div class={`reveal reveal-delay-${(i % 3) + 1} bg-white border border-border rounded-[16px] p-6 hover:shadow-lg hover:-translate-y-1 hover:border-[#8CC63F]/40 transition-all`}>
          <div class="w-11 h-11 rounded-[10px] bg-[#8CC63F]/10 text-[#4B9511] flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={b.icon} /></svg>
          </div>
          <h3 class="text-[18px] font-bold text-secondary mb-2">{b.title}</h3>
          <p class="text-[15px] text-muted-foreground leading-relaxed">{b.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

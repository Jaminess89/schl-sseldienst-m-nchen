---
// NEW SECTION L — Contact form (static; no fictional contact data)
import { SITE } from '@/config/site';
---

<section id="anfrage" class="py-16 md:py-24 bg-secondary text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.06]" style="background-image:radial-gradient(circle at 20% 20%, #fff 1px, transparent 1px);background-size:32px 32px;"></div>
  <div class="max-w-[720px] mx-auto px-4 relative">
    <div class="text-center mb-10 reveal">
      <span class="inline-block text-[13px] font-bold uppercase tracking-wider text-[#8CC63F] bg-white/10 px-3 py-1 rounded-full mb-4">Unverbindliche Anfrage</span>
      <h2 class="text-3xl md:text-[40px] font-bold tracking-tight mb-4">Teilen Sie uns die Eckdaten Ihres Objekts mit</h2>
      <p class="text-[16px] text-white/80 leading-relaxed">Wir prüfen Ihre Angaben und melden uns mit den möglichen nächsten Schritten bei Ihnen. Ihre Anfrage ist unverbindlich.</p>
    </div>

    <form id="contact-form" class="reveal bg-white rounded-[18px] p-6 md:p-8 shadow-2xl text-secondary space-y-4" novalidate>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="cf-name" class="block text-[13px] font-bold mb-1.5">Name *</label>
          <input id="cf-name" name="name" type="text" required class="w-full border border-border rounded-[10px] px-4 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#8CC63F]/50 focus:border-[#8CC63F]" />
        </div>
        <div>
          <label for="cf-company" class="block text-[13px] font-bold mb-1.5">Unternehmen / Verwaltung</label>
          <input id="cf-company" name="company" type="text" class="w-full border border-border rounded-[10px] px-4 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#8CC63F]/50 focus:border-[#8CC63F]" />
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="cf-phone" class="block text-[13px] font-bold mb-1.5">Telefon *</label>
          <input id="cf-phone" name="phone" type="tel" required class="w-full border border-border rounded-[10px] px-4 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#8CC63F]/50 focus:border-[#8CC63F]" />
        </div>
        <div>
          <label for="cf-email" class="block text-[13px] font-bold mb-1.5">E-Mail *</label>
          <input id="cf-email" name="email" type="email" required class="w-full border border-border rounded-[10px] px-4 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#8CC63F]/50 focus:border-[#8CC63F]" />
        </div>
      </div>
      <div>
        <label for="cf-address" class="block text-[13px] font-bold mb-1.5">Objektadresse</label>
        <input id="cf-address" name="address" type="text" class="w-full border border-border rounded-[10px] px-4 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#8CC63F]/50 focus:border-[#8CC63F]" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="cf-count" class="block text-[13px] font-bold mb-1.5">Anzahl Wohnungen</label>
          <input id="cf-count" name="units" type="number" min="1" class="w-full border border-border rounded-[10px] px-4 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#8CC63F]/50 focus:border-[#8CC63F]" />
        </div>
        <div>
          <label for="cf-date" class="block text-[13px] font-bold mb-1.5">Gewünschter Zeitraum</label>
          <input id="cf-date" name="date" type="text" placeholder="z. B. nächster Monat" class="w-full border border-border rounded-[10px] px-4 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#8CC63F]/50 focus:border-[#8CC63F]" />
        </div>
      </div>
      <div>
        <label for="cf-message" class="block text-[13px] font-bold mb-1.5">Kurzbeschreibung</label>
        <textarea id="cf-message" name="message" rows="4" class="w-full border border-border rounded-[10px] px-4 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#8CC63F]/50 focus:border-[#8CC63F]"></textarea>
      </div>

      <p id="cf-error" class="hidden text-[14px] font-semibold text-red-600">Bitte füllen Sie die Pflichtfelder aus.</p>

      <button type="submit" class="w-full bg-[#8CC63F] hover:bg-[#7ab336] text-white font-bold text-[17px] px-8 py-4 rounded-[10px] transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5">Anfrage unverbindlich senden</button>
      <p class="text-[12px] text-muted-foreground leading-relaxed">Mit dem Absenden stimmen Sie der Verarbeitung Ihrer Angaben zur Bearbeitung der Anfrage zu. Details finden Sie in der <a href="/datenschutz/" class="underline hover:text-[#4B9511]">Datenschutzerklärung</a>. Hinweis: Dieses Formular ist aktuell statisch und übermittelt noch keine Daten; es wird vor dem Go-Live an einen Versand angebunden.</p>
      <p class="text-[13px] text-muted-foreground">Alternativ erreichen Sie uns telefonisch unter <a class="font-semibold text-secondary hover:text-[#4B9511] no-underline" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a> <span class="text-[11px]">(Kontaktdaten vor Veröffentlichung prüfen)</span>.</p>
    </form>

    <div id="cf-success" class="hidden reveal bg-white rounded-[18px] p-8 shadow-2xl text-secondary text-center">
      <span class="inline-flex w-14 h-14 rounded-full bg-[#8CC63F]/15 text-[#4B9511] items-center justify-center mb-4"><svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg></span>
      <h3 class="text-[22px] font-bold mb-2">Vielen Dank für Ihre Anfrage.</h3>
      <p class="text-[15px] text-muted-foreground">Wir prüfen Ihre Angaben und melden uns zeitnah bei Ihnen.</p>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('contact-form');
  const success = document.getElementById('cf-success');
  const error = document.getElementById('cf-error');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const required = form.querySelectorAll('[required]');
    let ok = true;
    required.forEach((f) => { if (!f.value.trim()) { ok = false; f.classList.add('border-red-500'); } else { f.classList.remove('border-red-500'); } });
    if (!ok) { error?.classList.remove('hidden'); return; }
    error?.classList.add('hidden');
    form.classList.add('hidden');
    success?.classList.remove('hidden');
    success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>

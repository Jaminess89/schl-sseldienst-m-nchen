---
// Sticky mobile call-to-action bar
import { SITE } from '@/config/site';
---

<div id="sticky-mobile-bar" class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-border shadow-[0_-4px_20px_rgba(0,0,0,0.08)] px-3 py-2.5 grid grid-cols-2 gap-2.5 translate-y-full transition-transform duration-300">
  <a href={`tel:${SITE.phone}`} class="flex items-center justify-center gap-2 bg-[#1AAAE6] text-white font-bold text-[15px] py-3 rounded-[10px] no-underline">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
    Anrufen
  </a>
  <a href="#anfrage" class="flex items-center justify-center gap-2 bg-[#8CC63F] text-white font-bold text-[15px] py-3 rounded-[10px] no-underline">
    Anfrage
  </a>
</div>

<script is:inline>
  const bar = document.getElementById('sticky-mobile-bar');
  const onScroll = () => {
    if (window.scrollY > 420) bar?.classList.remove('translate-y-full');
    else bar?.classList.add('translate-y-full');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';
---

<BaseLayout title={`Impressum | ${SITE.name}`} noIndex={true}>
  <section class="py-16 bg-white">
    <Container>
      <div class="max-w-[760px]">
        <h1 class="text-[36px] font-black text-secondary mb-8">Impressum</h1>
        <div class="prose text-[15px] leading-[1.8] text-[#4A5568]">
          <h2 class="text-[20px] font-bold text-secondary mt-8 mb-3">Angaben gemäß § 5 TMG</h2>
          <p>
            {SITE.name}<br />
            <!-- TODO: Rechtsform + Inhaber/Geschäftsführer eintragen -->
            Straße und Hausnummer<br />
            PLZ Berlin<br />
            Deutschland
          </p>
          <h2 class="text-[20px] font-bold text-secondary mt-8 mb-3">Kontakt</h2>
          <p>
            Telefon: {SITE.phoneDisplay}<br />
            E-Mail: <!-- TODO: E-Mail-Adresse -->
          </p>
          <h2 class="text-[20px] font-bold text-secondary mt-8 mb-3">Umsatzsteuer-ID</h2>
          <p>Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: <!-- TODO --></p>
          <h2 class="text-[20px] font-bold text-secondary mt-8 mb-3">Verantwortlich für den Inhalt nach § 55 Abs. 2 RStV</h2>
          <p><!-- TODO: Name + Anschrift --></p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
